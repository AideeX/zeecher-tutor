# Node 24+ with a writable, private persistent directory is required.
# Next.js loads .env.local. No external API credential is needed.
COACH_DATA_DIR=.local
UNDER13_AI_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# For HTTPS deployments set the exact public origin and secure cookies:
# APP_ORIGIN=https://your-private-host.example
COOKIE_SECURE=false
# Optional first-family setup code, supplied privately by the operator.
# If omitted, npm run setup generates .local/setup-code (mode 0600).
# PARENT_SETUP_CODE=

# Firebase Phase 1 foundation ONLY: leave these unset until the next phase.
# These declarations do not switch the current app away from SQLite.
# No database/location has been approved or created.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=
# FIRESTORE_DATABASE_ID=(default)
# FIREBASE_ADMIN_CREDENTIAL_MODE=workload-identity
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=
# ZEECHER_PLATFORM_ADMIN_UID=
# RATE_LIMIT_HMAC_SECRET=
# Private-key fallback is server-only and must never be committed or shared:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Local emulators only: use a demo-* project ID and both loopback hosts.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
