# Node 24+ with a writable, private persistent directory is required.
# Next.js loads .env.local. No external API credential is needed.
COACH_DATA_DIR=.local
UNDER13_AI_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# For HTTPS deployments set the exact public origin and secure cookies:
# APP_ORIGIN=https://your-private-host.example
COOKIE_SECURE=false
# Optional first-family setup code, supplied privately by the operator.
# If omitted, npm run setup generates .local/setup-code (mode 0600).
# PARENT_SETUP_CODE=
